# Copy to .env at the repository root. .env is ignored by Git.
ZK_POSTGRES_PORT=5433
ZK_API_PORT=8000
# Local API only; Docker Compose supplies its own internal database URL.
ZK_DATABASE_URL=postgresql+asyncpg://zk:zk@localhost:5433/zk
ZK_WHISPER_MODEL=base
ZK_MAX_UPLOAD_MB=100
ZK_MAX_MEDIA_SECONDS=7200
ZK_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Optional local API storage override (default: ~/zettelkasten)
# ZK_DATA_DIR=/absolute/path/to/vault
# ZK_WHISPER_CACHE_DIR=/absolute/path/to/model-cache
